# Server-only credentials. Keep these out of browser and Expo bundles.
SUPABASE_SECRET_KEY=
SUPABASE_DATABASE_CONNECTION_STRING=
YOUCAM_API_KEY=
CLERK_SECRET_KEY=

# Optional local-only identity for the live E2E suite. Ignored in production
# and for non-loopback requests; never configure this in a deployment.
E2E_TEST_USER_ID=

# Safe to expose to the browser/mobile client when prefixed as shown.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Public app URLs used for links, metadata, and the Expo API client.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Expo reads these public-prefixed values. Set the API URL to a LAN-reachable
# Next.js address when running the seller app on a physical device.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Optional: omit during Expo Go development so Expo can generate its own callback.
EXPO_PUBLIC_AUTH_REDIRECT_URL=rackstage://auth/callback
